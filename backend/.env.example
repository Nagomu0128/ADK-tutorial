# Gemini API (required for LLM agents)
GOOGLE_API_KEY=your-gemini-api-key

# Stock Data APIs
ALPHA_VANTAGE_API_KEY=demo
TWELVE_DATA_API_KEY=your-twelve-data-key
FINNHUB_API_KEY=your-finnhub-key
MARKETAUX_API_KEY=your-marketaux-key

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_advisor
DB_USER=postgres
DB_PASSWORD=postgres

# Cloud SQL (production only - overrides DB_HOST)
# CLOUD_SQL_CONNECTION_NAME=project:region:instance

# Firebase Authentication
# FIREBASE_PROJECT_ID=your-firebase-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Agent URLs (defaults to localhost)
# NEWS_AGENT_URL=http://localhost:3002
# STOCK_AGENT_URL=http://localhost:3003
# SENTIMENT_AGENT_URL=http://localhost:3004
# USER_PROFILE_AGENT_URL=http://localhost:3005
# RISK_AGENT_URL=http://localhost:3006
# REPORT_AGENT_URL=http://localhost:3007
