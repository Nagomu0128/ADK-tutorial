{
  "name": "stock-advisor-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "orchestrator",
    "news-agent",
    "stock-agent",
    "sentiment-agent",
    "user-profile-agent",
    "risk-agent",
    "report-agent"
  ],
  "scripts": {
    "dev:orchestrator": "npm run dev -w orchestrator",
    "dev:news": "npm run dev -w news-agent",
    "dev:stock": "npm run dev -w stock-agent",
    "dev:sentiment": "npm run dev -w sentiment-agent",
    "dev:profile": "npm run dev -w user-profile-agent",
    "dev:risk": "npm run dev -w risk-agent",
    "dev:report": "npm run dev -w report-agent",
    "build": "npm run build --workspaces --if-present",
    "lint": "tsc --noEmit --project tsconfig.json",
    "db:migrate": "node db/migrate.mjs up",
    "db:migrate:down": "node db/migrate.mjs down"
  },
  "devDependencies": {
    "@types/node": "^20.11.17",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "node-pg-migrate": "^8.0.4"
  }
}
